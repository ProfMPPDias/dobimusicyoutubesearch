# ===== 小智 MCP 接入点 =====
# 登录小智控制台（xiaozhi.me），进入智能体 -> 配置角色页面，
# 复制该智能体专属的 MCP 接入点地址：
MCP_ENDPOINT=wss://api.xiaozhi.me/mcp/?token=在此填写你的token

# ===== 音乐源 =====
# 可用: kuwo(酷我) netease(网易云) migu(咪咕) kugou(酷狗)
MUSIC_SOURCES=kuwo,netease,migu,kugou

# ===== 网络 =====
SOURCE_TIMEOUT=15
# 如需要代理（例如某些网络环境），取消注释：
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890

# ===== 播放 =====
# 本地播放器: none / mpv / vlc（小智硬件播放不需要本地播放器）
LOCAL_PLAYER=none
AUTO_PLAY_LOCAL=false
# 播放地址解析失败时最多尝试的候选歌曲数
MAX_RESOLVE_TRIES=6
# resource/read 单页最大字节数（小智默认每页 100KB）
MAX_PAGE_SIZE=1048576

# ===== 其他 =====
LOG_LEVEL=INFO
CACHE_DIR=./cache
