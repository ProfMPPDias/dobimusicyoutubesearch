{
  "mcpServers": {
    "xiaozhi-music": {
      "type": "stdio",
      "command": "python",
      "args": [
        "-m",
        "music_mcp"
      ],
      "env": {
        "MUSIC_SOURCES": "youtube,kuwo,netease",
        "LOCAL_PLAYER": "none",
        "AUTO_PLAY_LOCAL": "false",
        "LOG_LEVEL": "INFO"
      }
    }
  }
}